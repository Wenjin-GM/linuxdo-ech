<?xml version="1.0" encoding="utf-8"?>
<!--
  放入 app/src/main/res/xml/network_security_config.xml，
  并在 AndroidManifest 的 <application android:networkSecurityConfig="@xml/network_security_config">。
  本地 CA 证书（DER/PEM）放入 app/src/main/res/raw/ech_local_ca.cer。
  注意：WebView 只能通过此配置信任证书，无法用代码注入 TrustManager，因此 CA 必须固定。
-->
<network-security-config>

    <!-- linux.do 系域名：系统 CA + 本地 MITM CA -->
    <domain-config>
        <domain includeSubdomains="true">linux.do</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/ech_local_ca" />
        </trust-anchors>
    </domain-config>

    <!-- 到本地回环代理的明文 HTTP 连接 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/ech_local_ca" />
        </trust-anchors>
    </domain-config>

    <!-- 其余域名走默认系统信任 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
